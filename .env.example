# Copy this file to `.env` and fill in the keys you actually have.
# `.env` is gitignored. Do NOT commit it.

# ── Chat backend selection ────────────────────────────────────────────────
# Which provider drives the conversation. One of:
#   Gateway: aigcbest / openrouter
#   Official API: openai / anthropic / gemini / dashscope
OPH_WEB_BACKEND=aigcbest
# Main chat model id (format depends on the backend, e.g. gpt-5.5,
# qwen3-vl-plus, anthropic/claude-...).
OPH_WEB_MODEL=gpt-5.5
# Optional dedicated VISION model for image impressions / modality fallback.
# Runs on the same backend. Set this when the chat model is text-only
# (e.g. deepseek), otherwise leave blank (then it's skipped, never faked).
OPH_WEB_VISION_MODEL=
# Optional: default thinking effort (low / medium / high)
# OPH_WEB_EFFORT=low

# ── Provider API keys (fill in only the ones you use) ─────────────────────
# aigcbest (https://api2.aigcbest.top/)
AIGCBEST_API_KEY=
# AIGCBEST_BASE_URL=https://api2.aigcbest.top/v1
# DashScope / Model Studio (https://bailian.console.aliyun.com/)
DASHSCOPE_API_KEY=
# Singapore/international endpoint (leave blank for the Beijing default):
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OpenRouter (https://openrouter.ai/)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Official OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Official Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Official Google Gemini
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# HuggingFace (for gated downloads in some adapters; optional)
# HF_TOKEN=

# ─── Optional external model/tool paths ─────────────────────────────────
# Keep private and mutable deployment state outside the source checkout. With
# OPHAGENT_RUNTIME_DIR set, OphAgent reads weights from <runtime>/checkpoints,
# external model sources from <runtime>/external, writes generated files under
# <runtime>/reports, and uses <runtime>/cache. The Web server also looks for
# <runtime>/.env before falling back to a checkout-local .env.
# If unset, <runtime> defaults to ~/.ophagent.
# OPHAGENT_RUNTIME_DIR=
# OPHAGENT_ENV_FILE=
# OPHAGENT_OUTPUT_DIR=
# OPHAGENT_CACHE_DIR=
# Optional os.pathsep-separated old output roots used only when migrating
# persisted local Web sessions into the current runtime.
# OPHAGENT_LEGACY_OUTPUT_ROOTS=
#
# Fine-grained root overrides remain available when resources are split across
# multiple disks.
# OPHAGENT_ROOT=
# OPHAGENT_CKPT_DIR=
# OPHAGENT_EXTERNAL_DIR=
#
# Set individual overrides only for tools you relocate separately. If unset,
# adapters use the release layout above and fail with a clear message when a
# required source tree or checkpoint is missing.

# CFP tools
# OPHAGENT_MODALITY_CLASSIFIER_WEIGHTS=
# OPHAGENT_CFP_CLIP_SRC=
# OPHAGENT_CFP_CLIP_WEIGHTS=
# OPHAGENT_RETIZERO_ROOT=
# OPHAGENT_RETIZERO_WEIGHTS=
# OPHAGENT_FLAIR_ROOT=
# OPHAGENT_FLAIR_WEIGHTS=
# OPHAGENT_EYEQ_SRC=
# OPHAGENT_EYEQ_WEIGHTS=
# OPHAGENT_GLAUCOMA_WEIGHTS=
# OPHAGENT_EFIQA_WEIGHTS=
# Built-in PDR inference is the default. These source overrides are retained
# only for compatibility with older local deployments.
# OPH_PDR_BACKEND=builtin
# OPHAGENT_PDR_SRC=
# OPHAGENT_PDR_DEPLOY=
# OPHAGENT_PDR_MAIN_CKPT=
# OPHAGENT_PDR_ACTIVE_CKPT=
# OPHAGENT_PDR_ACTIVE_THR=
# OPHAGENT_PDR_INACTIVE_CKPT=
# OPHAGENT_PDR_INACTIVE_THR=
# OPHAGENT_OD_SRC=
# OPHAGENT_OD_WEIGHTS=
# OPHAGENT_RETSAM_SRC=
# OPHAGENT_RETSAM_CKPT=

# OCT / UWF / FFA tools
# OPHAGENT_FMUE_SRC=
# OPHAGENT_FMUE_WEIGHTS=
# OPHAGENT_OCT_FLUID_WEIGHTS=
# OPHAGENT_OCT_LAYER_WEIGHTS=
# OPHAGENT_OCT_QUALITY_WEIGHTS=
# OPHAGENT_G_DISC_ROOT=
# OPHAGENT_G_DISC_SEGMENTATION_WEIGHTS=
# OPHAGENT_G_DISC_WNET_WEIGHTS=
# OPHAGENT_G_DISC_3DOCT_HISTOGRAM=
# OPHAGENT_G_DISC_TRITON_HISTOGRAM=
# OPHAGENT_OCTCUBEM_ROOT=
# OPHAGENT_OCTCUBEM_WEIGHTS=
# OPHAGENT_UWF_SRC=
# OPHAGENT_UWF_WEIGHTS=
# OPHAGENT_UWF_DISEASE7_WEIGHTS=
# OPHAGENT_PRIME_FP20_SRC=
# OPHAGENT_PRIME_FP20_WEIGHTS=
# OPHAGENT_FFA_PROJECT=
# OPHAGENT_FFA_CLASSIFIER_WEIGHTS=
# OPHAGENT_FFA_DETECTOR_WEIGHTS=
# OPHAGENT_FFA_MERGE_MAP=
# OPHAGENT_PAIRED_CFP_WEIGHTS=
# OPHAGENT_PAIRED_FFA_WEIGHTS=
# OPHAGENT_PAIRED_JOINT_WEIGHTS=
# OPHAGENT_PAIRED_REPORT_EXEMPLARS=

# ── Web deployment auth ───────────────────────────────────────────────────
# Basic Auth: required when binding to a public interface (OPH_WEB_HOST is not
# 127.0.0.1) or proxying through a tunnel. Second line of defense behind any
# upstream access control.
WEB_USERNAME=
WEB_PASSWORD=

# Optional Cloudflare Access JWT verification (when fronted by Cloudflare
# Access). Leave blank to disable.
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-application-audience-tag

# Optional: comma-separated emails allowed to manage shared runtime settings.
# Administrative status does not grant access to other users' conversations.
# WEB_ADMIN_EMAILS=you@example.com

# Optional tuning
# OPH_WEB_HOST=127.0.0.1
# OPH_WEB_PORT=8765
# WEB_RATE_LIMIT=30/minute
# WEB_MAX_UPLOAD_MB=80
# WEB_MAX_IMAGE_PIXELS=80000000
